    "# Select the 50 most connected nodes\n",
    "degree_dict = dict(G.degree())\n",
    "\n",
    "top_nodes = sorted(\n",
    "    degree_dict,\n",
    "    key=degree_dict.get,\n",
    "    reverse=True\n",
    ")[:50]\n",
    "\n",
    "# Create a subgraph containing these nodes\n",
    "H = G.subgraph(top_nodes).copy()\n",
    "\n",
    "# Create the layout\n",
    "plt.figure(figsize=(12, 10))\n",
    "\n",
    "pos = nx.spring_layout(H, seed=42)\n",
    "\n",
    "nx.draw_networkx_nodes(\n",
    "    H,\n",
    "    pos,\n",
    "    node_size=500,\n",
    "    node_color=\"skyblue\",\n",
    "    edgecolors=\"black\"\n",
    ")\n",
    "\n",
    "nx.draw_networkx_edges(\n",
    "    H,\n",
    "    pos,\n",
    "    arrows=True,\n",
    "    arrowsize=10,\n",
    "    alpha=0.5\n",
    ")\n",
    "\n",
    "nx.draw_networkx_labels(\n",
    "    H,\n",
    "    pos,\n",
    "    font_size=8\n",
    ")\n",
    "\n",
    "plt.title(\"Bitcoin Alpha Trust Network – Top 50 Connected Users\")\n",
